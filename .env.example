# ===================================================================
# CyberSentinel Frontend Environment Variables (.env.example)
# ===================================================================

# Public API Base URL
# Development: http://localhost:8000
# Production: Set to your deployed FastAPI backend URL (e.g. on Render)
# Example: NEXT_PUBLIC_API_BASE_URL=https://cybersentinel-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
