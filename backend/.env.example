# ===================================================================
# CyberSentinel Backend Environment Configuration (Production Template)
# ===================================================================

# Application Identity & Mode
APP_NAME="CyberSentinel API"
# Environment: 'development', 'staging', or 'production'
# In 'production', missing required secrets or MongoDB URI causes startup failure.
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=false

# Server Binding
HOST="0.0.0.0"
PORT=8000

# CORS: Comma-separated allowed frontend origins (NO wildcards in production)
# Example for production: https://cybersentinel.vercel.app
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB Atlas Configuration (MANDATORY in production)
# Use a least-privilege user with readWrite role scoped exclusively to 'cybersentinel'
# Example: mongodb+srv://<soc_user>:<soc_password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb_connection_string_placeholder"
MONGODB_DATABASE="cybersentinel"
MONGODB_TIMEOUT_MS=5000

# Demonstration / Simulated Data Fallback Mode
# Set to false for live enterprise SOC telemetry
DEMO_MODE=true

# Security & Cryptographic Token Configuration (MANDATORY in production)
# In production, JWT_SECRET_KEY MUST be a random string >= 32 characters
# Generate using: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="generate_and_insert_a_32_byte_random_secret_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REQUIRED=true

# Initial Default Credentials (used only to seed initial accounts if DB is empty)
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="replace_with_strong_initial_admin_password_min_8_chars"
ANALYST_DEFAULT_USERNAME="analyst"
ANALYST_DEFAULT_PASSWORD="replace_with_strong_initial_analyst_password_min_8_chars"

# Rate Limiting & Protection Parameters
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=15

# Payload and Upload Size Limits (Bytes)
MAX_REQUEST_BODY_BYTES=15728640
MAX_UPLOAD_SIZE_BYTES=10485760
