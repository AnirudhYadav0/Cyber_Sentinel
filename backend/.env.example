# CyberSentinel Backend Environment Configuration
APP_NAME="CyberSentinel API"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true

# Server configuration
HOST="0.0.0.0"
PORT=8000

# CORS: configured for Next.js local frontend origin
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb_connection_string_placeholder"
MONGODB_DATABASE="cybersentinel"
MONGODB_TIMEOUT_MS=5000

# Demo Mode
DEMO_MODE=true
